+// Umbra extension: negotiate Lumen's optional reverse microphone UDP flow
+// without changing the transport syntax used by the pinned GameStream streams.
+static bool setupClientMicrophoneStream(PRTSP_MESSAGE response, int* error) {
+    RTSP_MESSAGE request;
+    bool ret;
+    char transportValue[64];
+
+    *error = -1;
+    if (!umbra_client_microphone_rtsp_format_transport(transportValue, sizeof(transportValue))) {
+        return false;
+    }
+
+    ret = initializeRtspRequest(&request, "SETUP", umbra_client_microphone_rtsp_setup_target());
+    if (ret) {
+        if ((hasSessionId && !addOption(&request, "Session", sessionIdString)) ||
+            !addOption(&request, "Transport", transportValue) ||
+            !addOption(&request, "If-Modified-Since", "Thu, 01 Jan 1970 00:00:00 GMT")) {
+            ret = false;
+        }
+        else {
+            ret = transactRtspMessage(&request, response, false, error);
+        }
+        freeMessage(&request);
+    }
+
+    return ret;
+}
