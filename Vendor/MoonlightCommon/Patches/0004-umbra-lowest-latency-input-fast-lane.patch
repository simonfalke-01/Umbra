+#if defined(UMBRA_STREAM_TESTING)
+int LiTestGetInputBatchingDelayMs(
+    int optimizationMode,
+    uint64_t now,
+    uint64_t lastPacketTime,
+    int intervalMs
+) {
+    if (intervalMs <= 0) {
+        return 0;
+    }
+    return getInputBatchingDelayMs(optimizationMode, now, lastPacketTime, intervalMs);
+}
+
+int LiTestInitializeInputStream(
+    int optimizationMode,
+    LiTestInputPacketCallback packetCallback,
+    void* context
+) {
+    if (testInputStreamOwned || packetCallback == NULL ||
+        optimizationMode < STREAM_OPTIMIZATION_MODE_LEGACY ||
+        optimizationMode > STREAM_OPTIMIZATION_MODE_QUALITY) {
+        return -1;
+    }
+
+    LiInitializeStreamConfiguration(&StreamConfig);
+    StreamConfig.optimizationMode = optimizationMode;
+    AppVersionQuad[0] = 7;
+    AppVersionQuad[1] = 1;
+    AppVersionQuad[2] = 431;
+    AppVersionQuad[3] = -1;
+    SunshineFeatureFlags = LI_FF_PEN_TOUCH_EVENTS;
+    testInputPacketCallback = packetCallback;
+    testInputCallbackContext = context;
+
+    int result = initializeInputStream();
+    if (result == 0) {
+        testInputStreamOwned = true;
+    }
+    else {
+        testInputPacketCallback = NULL;
+        testInputCallbackContext = NULL;
+    }
+    return result;
+}
+
+int LiTestStartInputStream(void) {
+    return testInputStreamOwned ? startInputStream() : -1;
+}
+
+void LiTestDestroyInputStream(void) {
+    if (!testInputStreamOwned) {
+        return;
+    }
+    if (initialized) {
+        stopInputStream();
+    }
+    destroyInputStream();
+    testInputStreamOwned = false;
+    testInputPacketCallback = NULL;
+    testInputCallbackContext = NULL;
+}
+
+int LiTestGetInputQueueCapacity(void) {
+    return MAX_QUEUED_INPUT_PACKETS;
+}
+#endif
