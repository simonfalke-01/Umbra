+bool LiTestOfferCompleteVideoDecodeUnit(unsigned int frameNumber) {
+    PQUEUED_DECODE_UNIT qdu = calloc(1, sizeof(*qdu));
+    PLENTRY_INTERNAL buffer = calloc(1, sizeof(*buffer));
+    char* payload = malloc(1);
+    if (qdu == NULL || buffer == NULL || payload == NULL) {
+        free(qdu);
+        free(buffer);
+        free(payload);
+        return false;
+    }
+
+    payload[0] = 0;
+    buffer->allocPtr = payload;
+    buffer->entry.data = payload;
+    buffer->entry.length = 1;
+    buffer->entry.bufferType = BUFFER_TYPE_PICDATA;
+    qdu->decodeUnit.bufferList = &buffer->entry;
+    qdu->decodeUnit.fullLength = 1;
+    qdu->decodeUnit.frameType = FRAME_TYPE_PFRAME;
+    qdu->decodeUnit.frameNumber = (int)frameNumber;
+    return offerDecodeUnitToQueue(qdu);
