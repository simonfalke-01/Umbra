+    // Free the DU we were going to queue
+    free(qdu);
+
+    // Free all frames in the decode unit queue
+    freeDecodeUnitList(LbqFlushQueueItems(&decodeUnitQueue));
+
+    // Request an IDR frame to recover
+    requestDecodeQueueIdrRecovery();
+    return false;
