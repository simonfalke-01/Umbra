+static bool offerDecodeUnitToQueue(PQUEUED_DECODE_UNIT qdu) {
+    if (LbqOfferQueueItem(&decodeUnitQueue, qdu, &qdu->entry) != LBQ_BOUND_EXCEEDED) {
+        return true;
+    }
+
+    Limelog("Video decode unit queue overflow\n");
+
+    // RFI recovery is not supported here. The queued frames may depend on the
+    // dropped frame, so flush them and recover from a complete IDR frame.
+    waitingForIdrFrame = true;
